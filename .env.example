# Copy to .env and fill in. .env is git-ignored.

# Any PostgreSQL URL works, including hosted ones (e.g. Neon: postgresql://user:pass@host/db?sslmode=require).
# WARNING: seed.py and the tests wipe this database. Use a throwaway one.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/grn_ledger

# ASSUMPTION: approval threshold, INR. PO total above this stays pending_approval.
APPROVAL_THRESHOLD_INR=100000

# ASSUMPTION: over-delivery tolerance, percent of ordered qty.
OVER_DELIVERY_TOLERANCE_PCT=5

# Optional. Chase drafts are template-only unless BOTH are set. Groq (OpenAI-compatible API).
GROQ_API_KEY=
# Pick a model name from your Groq console. Deliberately not hard-coded.
GROQ_MODEL=

# Optional. Where chase drafts are logged (never sent anywhere).
# CHASE_LOG_PATH=drafts_log/chase_drafts.jsonl
